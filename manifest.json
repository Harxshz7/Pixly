{
  "manifest_version": 3,
  "name": "Pixly",
  "version": "1.0.0",
  "description": "AI-powered design analysis — select text, capture images, or draw boxes to get AI explanations, prompts, and UI descriptions.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Pixly"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "css": ["content-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "context_menus": [
    {
      "id": "pixly-explain-selection",
      "title": "Pixly: Explain selected text",
      "contexts": ["selection"]
    },
    {
      "id": "pixly-analyze-image",
      "title": "Pixly: Analyze this image",
      "contexts": ["image"]
    }
  ]
}
